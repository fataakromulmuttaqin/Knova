# ==============================================================================
# Knova Production Environment Configuration
# ==============================================================================

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# AgentRouter (sixth-position backup when Gemini is primary)
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_FALLBACK_MODELS=gpt-5.5
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_PROVIDER=google
LLM_AGENTROUTER_FALLBACK_ENABLED=true

# Google AI Studio: primary followed by four Gemini fallbacks
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Google OAuth (App Sign-In & Google Drive)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_APP_REDIRECT_URI=https://your-frontend-domain.com/api/login/google/callback
GOOGLE_REDIRECT_URI=https://your-frontend-domain.com/api/auth/callback

# Deployment URLs & CORS
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com
KNOVA_SESSION_SECRET=generate_a_secure_random_32_character_string_here
ENV=production

# Persistent runtime data. Mount durable storage at /data in production.
KNOVA_DATA_DIR=/data
# CHROMA_PERSIST_DIR=/data/chroma_store

# Obsidian knowledge vault mirroring (optional). When OBSIDIAN_VAULT_DIR points
# to an Obsidian vault, every indexed source (upload, URL, Drive) is also written
# there as a markdown note under KNOVA_VAULT_SUBDIR, plus an auto-maintained
# "Knova Index.md". Notes edited in Obsidian are never overwritten by re-ingest.
# OBSIDIAN_VAULT_DIR=/path/to/obsidian/vault
# KNOVA_VAULT_SUBDIR=Knova

# (Optional) Embedding model, reranker & Port
# Multilingual by default so Indonesian and English questions retrieve from
# sources written in either language. Changing RAG_EMBEDDING_MODEL requires
# re-embedding every indexed chunk.
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DEVICE=cpu
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANKER_DEVICE=cpu
# Cross-encoder logit cutoff. Higher drops more weak matches; -4.0 keeps vague
# but on-topic questions answerable without admitting unrelated passages.
RAG_RELEVANCE_CUTOFF=-4.0
RAG_RERANKER_BATCH_SIZE=8
PORT=7860
WEB_CONCURRENCY=1
